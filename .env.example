# ---------------------------------------------------------------------------
# Dawati — environment variables. Copy to .env.local (local) or set in your host.
# Never commit real values.
# ---------------------------------------------------------------------------

# Root secret (≥ 32 random characters). Derives the HMAC key for token hashes and the AES key
# that encrypts guest links / TOTP secrets. REQUIRED in production. Changing it invalidates every
# existing token, session and guest link. Generate: openssl rand -base64 48
APP_SECRET=

# PostgreSQL connection string (Supabase: Project Settings → Database → connection string,
# use the pooled "transaction" URL on serverless hosts). If empty in development, an embedded
# PostgreSQL (PGlite) is used under .data/pglite — zero setup, single process only.
DATABASE_URL=
# DATABASE_POOL_MAX=5
# ALLOW_EMBEDDED_DB=1          # allow PGlite in production (single small server only)
# PGLITE_DIR=.data/pglite

# One-time owner bootstrap secret for /owner/setup (≥ 16 chars). Remove it after the owner exists.
# Alternative: run `npm run owner:create` on the server.
OWNER_SETUP_TOKEN=

# Public URL used inside guest links and referral links (no trailing slash).
PUBLIC_BASE_URL=https://example.com

# Media storage: "local" (default, .data/uploads) or "supabase" (private bucket via service role).
STORAGE_DRIVER=local
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=        # server only — never expose to the browser
# SUPABASE_STORAGE_BUCKET=invitation-media

# Branding / contact (build-time, public)
# NEXT_PUBLIC_BRAND_NAME=دعوتي
# NEXT_PUBLIC_CONTACT_WHATSAPP=218912345678

# Local HTTP testing of a production build only (cookies without the Secure flag):
# INSECURE_COOKIES=1
